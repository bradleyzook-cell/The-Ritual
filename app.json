{
  "expo": {
    "name": "The Ritual",
    "slug": "the-ritual",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "theritual",
    "icon": "./assets/logo-ritual.png",
    "splash": {
      "image": "./assets/logo-ritual.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "plugins": [
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.warrbuilt.theritual",
      "buildNumber": "1",
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "LSApplicationQueriesSchemes": ["instagram", "instagram-stories"]
      }
    },
    "android": {
      "package": "com.warrbuilt.theritual",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-ritual.png",
        "backgroundColor": "#0A0A0A"
      }
    }
  }
}
